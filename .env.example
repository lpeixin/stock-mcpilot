# Stock MCPilot 环境变量样例
#
# 用法：cp .env.example .env 然后按需修改。.env 已被 .gitignore 忽略。
#
# 环境变量的优先级**高于** ~/.stock-mcpilot/config.json。
# 被环境变量锁定的字段会在设置页顶部标出来（locked_by_env），
# 免得你改了界面却没生效、又查不出原因。
#
# 绝大多数人**不需要**这个文件：直接打开应用 → 设置 → 选服务商、填 Key 即可。
# 它主要给开发、CI、以及"不想把 Key 落在配置文件里"的场景用。

# ---------------------------------------------------------------------------
# 模型服务
# ---------------------------------------------------------------------------
# 预设名，见 backend/config.py 的 PROVIDER_PRESETS：
#   ollama / lmstudio / openai / anthropic / deepseek / moonshot /
#   dashscope / zhipu / siliconflow / custom
SMP_LLM_PRESET=ollama

# 协议类型，一般不用填 —— 不填会根据 preset 自动判定。
#   ollama | openai_compat | anthropic
# SMP_LLM_KIND=anthropic

# 接口地址。留空则用预设自带的地址。
#   Anthropic : https://api.anthropic.com
#   OpenAI    : https://api.openai.com/v1
#   Ollama    : http://127.0.0.1:11434
# SMP_LLM_BASE_URL=https://api.anthropic.com

# API Key。只存在本机，不会出网。
# SMP_LLM_API_KEY=sk-ant-xxxxxxxx

# 模型名。
# SMP_LLM_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# 分析与界面
# ---------------------------------------------------------------------------
# 分析输出语言：zh | en
# SMP_ANALYSIS_LANGUAGE=zh

# 后端监听地址与端口（默认只允许回环地址）
# SMP_BIND_HOST=127.0.0.1
# SMP_BIND_PORT=8000

# 配置目录覆盖。默认 ~/.stock-mcpilot
# STOCK_MCPILOT_HOME=/some/other/path

# ---------------------------------------------------------------------------
# 兼容旧变量（仍然有效，优先级低于上面 SMP_* 的同名项）
# ---------------------------------------------------------------------------
# LLM_MODE=cloud            -> 等价于 SMP_LLM_PRESET
# LLM_API_KEY=...           -> 等价于 SMP_LLM_API_KEY
# LLM_LOCAL_MODEL=...       -> 等价于 SMP_LLM_MODEL
# OLLAMA_ENDPOINT=...       -> 等价于 SMP_LLM_BASE_URL
# APP_LANGUAGE=...          -> 等价于 SMP_ANALYSIS_LANGUAGE
